{
    "name": "gallowglas-2023",
    "description": "Gallowglas 2023 Art Deco theme",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "ghost": ">=6.0.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "author": {
        "name": "Aria Stewart",
        "email": "aredridel@dinhe.net"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Custom"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/aredridel/gallowglas-2023-theme.git"
    },
    "bugs": "https://github.com/aredridel/gallowglas-2023-theme/issues",
    "config": {
        "posts_per_page": 15,
        "image_sizes": {
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        },
        "card_assets": true,
        "custom": {
		"testimage": {
                "type": "image"
            },
		"test1": {
                "type": "text",
                "default": "Sign up for more like this",
                "group": "post"
            }
        }
    },
    "scripts": {
        "dev": "gulp",
        "test": "gscan .",
        "zip": "gulp zip"
    },
    "devDependencies": {
    }
}
